# Copy this file to .env and fill in your key. Never commit .env (it is in .gitignore).

# Which LLM labels the evidence: gemini (default), groq or ollama
LLM_PROVIDER=gemini

# Optional: override the provider's default model
#   gemini default: gemini-3.5-flash-lite
#   groq default:   llama-3.3-70b-versatile
#   ollama default: llama3.2
LLM_MODEL=

# Only the key for the provider you use is needed.
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq: https://console.groq.com/keys
GROQ_API_KEY=

# Ollama runs locally and needs no key.
# OLLAMA_HOST=http://localhost:11434
